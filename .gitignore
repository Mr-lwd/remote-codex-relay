# Publish only project sources. Add new source types here and in scripts/release.py.
*
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.node-version
!/.prettierignore
!/.prettierrc.json
!/README.md
!/LICENSE
!/SECURITY.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/index.html
!/package.json
!/package-lock.json
!/pyproject.toml
!/requirements.in
!/requirements.txt
!/requirements-dev.txt
!/requirements-browser.txt
!/relay.example.toml
!/vite.config.js

!/server/
!/server/**/
!/server/**/*.py
!/src/
!/src/**/
!/src/**/*.js
!/src/**/*.jsx
!/src/**/*.css
!/scripts/
!/scripts/**/
!/scripts/**/*.py
!/scripts/**/*.sh
!/tests/
!/tests/**/
!/tests/**/*.py
!/docs/
!/docs/**/
!/docs/**/*.md
!/docs/images/interface-overview.png
!/docs/images/readme-banner-light.svg
!/docs/images/readme-banner-dark.svg
!/docs/images/readme-badges.svg
!/deploy/
!/deploy/**/
!/deploy/**/*.example
!/.github/
!/.github/workflows/
!/.github/workflows/**/
!/.github/workflows/**/*.yml
!/.github/workflows/**/*.yaml

# These exclusions take priority even inside allowed source directories.
# Dependencies, builds, execution data, attachments, local probes and archives
node_modules/
.venv/
.venv-*/
venv/
dist/
build/
runtime/
output/
tmp/
temp/
backups/
*.zip
*.tar
*.tar.*
*.gz
*.7z

# Local configuration, credentials and databases
relay.toml
.env
.env.*
*.local.*
.codex/
.claude/
access.txt
auth.json
credentials.*
secrets.*
*.sqlite
*.sqlite-*
*.db
*.db-*
*.log
*.log.*
*.pem
*.key
*.p12
*.pfx
*.keystore

# Tool caches and editor/OS files
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.coverage
.coverage.*
htmlcov/
playwright-report/
test-results/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.bak
*.orig
*.rej
*.swp
*.swo
*~
