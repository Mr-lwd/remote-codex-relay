{
  "name": "codex-remote",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "format": "prettier --write src index.html vite.config.js package.json .prettierrc.json",
    "format:check": "prettier --check src index.html vite.config.js package.json .prettierrc.json"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.6",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/themes": "^3.2.1",
    "katex": "^0.16.47",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "vite": "^6.3.5"
  },
  "description": "A self-hosted web console for local Codex sessions, tasks and attachments",
  "license": "MIT",
  "engines": {
    "node": ">=22 <25"
  }
}
